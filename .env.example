# Optional for direct host tooling. Compose development uses explicit mock settings instead.
# Mock is deterministic and makes no network calls.
MODEL_PROVIDER=mock
GCP_PROJECT_ID=stunning-crane-508614-c1
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_ATTEMPTS=2
# Optional estimates per million tokens; set from current model pricing.
INPUT_PRICE_PER_MILLION=0
OUTPUT_PRICE_PER_MILLION=0
# Required for Cloud Run; optional for loopback-only local development.
DEMO_API_KEY=
# API running on the host -> local or SSH-forwarded vLLM server.
VLLM_BASE_URL=http://127.0.0.1:8001/v1
VLLM_MODEL=google/gemma-4-E2B-it
VLLM_API_KEY=local-development-only
