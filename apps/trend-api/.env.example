# Local development never calls a paid model. Vertex AI uses the runtime service account.
MODEL_PROVIDER=mock
MODEL_REQUESTS_ENABLED=false
GCP_PROJECT_ID=
GOOGLE_CLOUD_LOCATION=global
# YouTube Data API v3 (GCP 콘솔 > API 및 서비스 > YouTube Data API v3 사용 설정 후 API 키 생성.
# Gemini 키와 같은 GCP 프로젝트에서 발급하면 키 하나로 둘 다 가능)
YOUTUBE_API_KEY=
# 네이버 데이터랩 검색어 트렌드 (https://developers.naver.com/apps 에서 애플리케이션 등록)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 모델 선택 (기본값 그대로 두면 됨)
GEMINI_MODEL=gemini-3.8-flash
GEMMA_LOCAL_MODEL=gemma4:12b
# 로컬 모델 백엔드. 비우면 Ollama. vLLM 등 OpenAI 호환 서버면 주소를 적고 GEMMA_LOCAL_MODEL 에 served-model-name 을 쓴다
# LOCAL_LLM_BASE_URL=http://127.0.0.1:11437/v1
# ADK 에이전트 자신의 모델. 기본 Gemini. local 이면 위 로컬 모델을 LiteLLM 으로 쓴다 (예산 소모 없음)
# ADK_MODEL=local

# Spanner Graph (사전 지식 그래프)
# 로컬: docker run -d --name spanner-emu -p 9010:9010 -p 9020:9020 gcr.io/cloud-spanner-emulator/emulator
SPANNER_EMULATOR_HOST=localhost:9010
# Set GCP_PROJECT_ID only when testing BigQuery or Vertex AI with ADC.

# --- 아래는 2~3주차 이후 ---
# BigQuery·Spanner 클라우드는 키가 아니라 ADC: gcloud auth application-default login
# GOOGLE_APPLICATION_CREDENTIALS=   # 서비스 계정 JSON 경로 (Cloud Run Job 용, 로컬은 ADC 로 충분)
# SPANNER_INSTANCE_ID=trend-dev
# SPANNER_DATABASE_ID=dictionary
# Reddit (선택, 영어권 밈 발원지) https://www.reddit.com/prefs/apps (script 타입)
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
GEMINI_DAILY_BUDGET=120
USE_LOCAL_GEMMA=0
PIPELINE_INTERVAL_HOURS=6
API_PORT=8080
WEB_ORIGINS=http://localhost:3100,http://localhost:3000
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
NAVER_API_HUB=1

# --- 계정 (scripts/set_account.py 가 채운다. 평문 비밀번호는 저장하지 않는다) ---
# 로그인한 사람은 자기 설정(세대·나라)을 갖고, reviewer:true 인 계정만 사전 검수를 할 수 있다.
# ACCOUNTS=[{"user":"admin","hash":"pbkdf2$...","reviewer":true},{"user":"demo","hash":"pbkdf2$..."}]
ACCOUNTS=
FRONTEND_API_TOKEN=
# 프론트는 apps/trend-web/.env.local 에 FRONTEND_API_TOKEN(같은 값)과 SESSION_SECRET 이 필요하다 — 서버 전용 값이라 브라우저에 나가지 않는다
