          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "channel": {
          "title": "Channel",
          "type": "string"
        },
        "published_at": {
          "format": "date-time",
          "title": "Published At",
          "type": "string"
        },
        "duration_sec": {
          "title": "Duration Sec",
          "type": "integer"
        },
        "view_count": {
          "default": 0,
          "title": "View Count",
          "type": "integer"
        },
        "like_count": {
          "default": 0,
          "title": "Like Count",
          "type": "integer"
        },
        "comment_count": {
          "default": 0,
          "title": "Comment Count",
          "type": "integer"
        },
        "region": {
          "title": "Region",
          "type": "string"
        },
        "category_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category Id"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "source": {
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "video_id",
        "url",
        "title",
        "channel",
        "published_at",
        "duration_sec",
        "region",
        "source"
      ],
      "title": "ShortsVideo",
      "type": "object"
    },
    "Term": {
      "properties": {
        "term_id": {
          "title": "Term Id",
          "type": "string"
        },
        "canonical": {
          "title": "Canonical",
          "type": "string"
        },
