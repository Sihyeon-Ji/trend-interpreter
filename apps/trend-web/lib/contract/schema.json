            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Diffusion"
        },
        "risk_level": {
          "anyOf": [
            {
              "enum": [
                "none",
                "caution",
                "avoid"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Risk Level"
        },
        "risk_reasons": {
          "items": {
            "type": "string"
          },
