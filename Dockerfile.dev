FROM node:24.21.0-bookworm-slim AS node
FROM ghcr.io/astral-sh/uv:0.12.15 AS uv
FROM python:3.12-slim-bookworm AS tooling

COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && ln -s ../lib/node_modules/corepack/dist/corepack.js /usr/local/bin/corepack
COPY --from=uv /uv /usr/local/bin/uv

WORKDIR /workspace
ENV UV_PROJECT_ENVIRONMENT=/opt/trend-venv UV_LINK_MODE=copy \
    PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    PATH="/opt/trend-venv/bin:$PATH"

FROM tooling AS development
COPY apps/trend-api/ apps/trend-api/
RUN uv sync --project apps/trend-api --locked
COPY apps/alert-relay/ apps/alert-relay/
RUN UV_PROJECT_ENVIRONMENT=/opt/alert-relay-venv uv sync --project apps/alert-relay --locked
COPY apps/trend-web/package.json apps/trend-web/pnpm-lock.yaml apps/trend-web/pnpm-workspace.yaml apps/trend-web/
RUN cd apps/trend-web && corepack pnpm install --frozen-lockfile
COPY apps/trend-web/ apps/trend-web/
COPY tests/ tests/
COPY scripts/ scripts/

FROM development AS browser-tests
WORKDIR /workspace/apps/trend-web
RUN corepack pnpm exec playwright install --with-deps chromium
WORKDIR /workspace
