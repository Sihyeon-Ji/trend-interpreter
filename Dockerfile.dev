FROM node:24.21.0-bookworm-slim AS node
FROM ghcr.io/astral-sh/uv:0.12.15 AS uv
FROM python:3.12-slim-bookworm AS tooling

COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx
COPY --from=uv /uv /usr/local/bin/uv

WORKDIR /workspace
ENV UV_PROJECT_ENVIRONMENT=/opt/venv UV_LINK_MODE=copy \
    PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH"

FROM tooling AS development
COPY pyproject.toml uv.lock ./
COPY apps/api/ apps/api/
RUN uv sync --locked
COPY apps/alert-relay/ apps/alert-relay/
RUN UV_PROJECT_ENVIRONMENT=/opt/alert-relay-venv uv sync --project apps/alert-relay --locked
COPY apps/web/package*.json apps/web/
RUN npm --prefix apps/web ci
COPY apps/web/ apps/web/
COPY tests/ tests/
COPY scripts/ scripts/
COPY evaluation-cases/ evaluation-cases/

FROM development AS browser-tests
WORKDIR /workspace/apps/web
RUN npx playwright install --with-deps chromium
WORKDIR /workspace
