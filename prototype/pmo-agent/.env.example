# Copy this to .env. .env is never committed.
# Issue your own values — never write a real key into this file.

# --- Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Whether to ask the model about board/code links the rules could not settle. Off by
# default (a call costs money and latency, and is less precise than the rules).
# Turn it on only to show the recall in a demo.
LINK_ASSIST=off
# Fetch the file paths each commit touched. Worth about a quarter more board<->code
# links, at one API call per commit — the slowest thing the agent does against a real
# repository. The local backend has the paths already and ignores this.
REPO_FILES=off

# --- Meeting notes: the only tool that holds words.
#     memory = the local JSON archive (no account needed)
#     notion = a real Notion database, which is where teams actually keep minutes
#
#     1. https://www.notion.so/profile/integrations
#        -> Personal access tokens -> New token
#        -> name it, tick the Notion API capability, Create token
#        -> copy the ntn_... secret (it is shown once)
#     2. open the notes database in Notion -> top-right ... -> Connections -> add that token
#     3. the database id is the part of its URL before the ?v= :
#        notion.so/<workspace>/<DATABASE_ID>?v=...
NOTES_BACKEND=memory
NOTION_TOKEN=
NOTION_DATABASE_ID=
#     Only if the date or author column cannot be found by type (rare). Use the exact
#     column name as it appears in Notion.
NOTION_DATE_PROPERTY=
NOTION_AUTHOR_PROPERTY=

# --- Jira sandbox (create a new site at https://www.atlassian.com/software/jira/free)
#     API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_SITE=echo-pmo-demo.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=ECHO

# --- Google Cloud (for deployment)
GCP_PROJECT_ID=
GCP_REGION=asia-northeast3

# --- Kaneo (stage 2, needs Docker)
KANEO_URL=http://localhost:1337

# --- GitHub (the real progress signal). No token here — it rides on a logged-in gh CLI.
#     Run gh auth login, then just name the repository below.
GITHUB_REPO=owner/repo

# --- optional
SLACK_BOT_TOKEN=

# --- Safety guard: sites writes are allowed to (comma separated). Never put a live domain here
WRITE_ALLOWLIST=echo-pmo-demo.atlassian.net,localhost
