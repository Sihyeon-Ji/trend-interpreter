# 복사해서 .env 로 쓰세요. .env 는 git에 올라가지 않습니다.
# 값은 각자 발급 — 이 파일에는 절대 실제 키를 적지 마세요.

# --- Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Jira 샌드박스 (https://www.atlassian.com/software/jira/free 로 새 사이트 생성)
#     API 토큰: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_SITE=echo-pmo-demo.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=ECHO

# --- Google Cloud (배포 단계)
GCP_PROJECT_ID=
GCP_REGION=asia-northeast3

# --- Kaneo (2단계, Docker 필요)
KANEO_URL=http://localhost:1337

# --- GitHub (실제 진척 신호). 토큰은 두지 않는다 — 로그인된 gh CLI 를 그대로 쓴다.
#     gh auth login 후 아래에 저장소만 적으면 된다.
GITHUB_REPO=owner/repo

# --- 선택
SLACK_BOT_TOKEN=

# --- 안전 가드: 쓰기가 허용된 사이트 (쉼표 구분). 실서비스 도메인은 절대 넣지 말 것
WRITE_ALLOWLIST=echo-pmo-demo.atlassian.net,localhost
